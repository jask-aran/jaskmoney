#!/usr/bin/env bash
set -euo pipefail
zero=0000000000000000000000000000000000000000
changed=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"; [ -n "$base" ] && range="$base..$local_sha"
  else range="$remote_sha..$local_sha"; fi
  git diff --name-only "$range" -- scripts/install.sh scripts/test-install.sh 2>/dev/null | grep -q . && changed=1
done
[ -n "$changed" ] || exit 0
echo "The installer changed: running it (scripts/test-install.sh release)…"
scripts/test-install.sh release || { echo "Not pushed: the installer test failed. (git push --no-verify skips it.)" >&2; exit 1; }
