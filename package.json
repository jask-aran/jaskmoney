{
  "name": "jaskmoney-opentui",
  "version": "1.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "module": "src/index.tsx",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run scripts/dev.ts",
    "server": "bun run src/server/main.ts",
    "build": "bun run scripts/build.ts",
    "test": "bun test --conditions=browser",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web",
    "bench": "bun test --conditions=browser ./src/bench/keys.bench.tsx",
    "eval": "bun --conditions=browser run src/eval/run.ts",
    "eval:search": "bun --conditions=browser run src/eval/search.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@unovis/solid": "1.7.1",
    "@unovis/ts": "1.7.1",
    "clsx": "^2.1.1",
    "lucide-solid": "1.25.0",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "^5.9.3"
  }
}
