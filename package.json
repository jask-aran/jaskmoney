{
  "name": "jaskmoney-opentui",
  "version": "1.0.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "module": "src/index.tsx",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run scripts/dev.ts",
    "server": "bun run src/server/main.ts",
    "build": "bun run scripts/build.ts",
    "bin": "bun run scripts/build.ts && ./dist/jaskmoney",
    "screenshots": "bun run scripts/screenshots.ts",
    "recordings": "bun run scripts/recordings.ts",
    "lint": "bun run scripts/lint.ts",
    "test": "bun run scripts/lint.ts && bun test --conditions=browser --parallel",
    "typecheck": "bun run scripts/lint.ts && tsc --noEmit",
    "bench": "bun test --conditions=browser ./src/bench/keys.bench.tsx",
    "eval": "bun --conditions=browser run src/eval/run.ts",
    "eval:search": "bun --conditions=browser run src/eval/search.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "^5.9.3"
  }
}
